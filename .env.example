# ==========================================
# Server Configuration
# ==========================================
PORT=3000

# ==========================================
# CORS Configuration (カンマ区切りでホワイトリスト指定)
# ==========================================
ALLOWED_ORIGINS=https://utamaro1221.github.io,http://localhost:3000,http://127.0.0.1:5500

# ==========================================
# Firebase Project ID (JWT Bearer Token検証用)
# ==========================================
FIREBASE_PROJECT_ID=tripdevelopment-d109d

# ==========================================
# API Credentials (バックエンド専用秘密鍵)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ==========================================
# Daily Limits (1日あたりの最大リクエスト数 / JST基準)
# ==========================================
DAILY_GEMINI_LIMIT=100
DAILY_PLACES_LIMIT=300
DAILY_PHOTO_LIMIT=600
DAILY_ROUTES_LIMIT=200
DAILY_WEATHER_LIMIT=300
